{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IG-Now",
  "version": "2.0.0",
  "identifier": "com.ignow.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Benedictus",
    "shortDescription": "IG-Now Desktop Application",
    "longDescription": "IG-Now is a high-performance cross-platform desktop application for Instagram (https://instagram.com)."
  },
  "plugins": {}
}
