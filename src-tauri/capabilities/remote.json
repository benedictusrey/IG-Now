{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "remote-instagram-com",
  "description": "Minimal native permissions granted to the instagram.com page: media saving, default-browser hand-off, downloader launch, and scoped fallback probes.",
  "windows": [
    "instagram"
  ],
  "remote": {
    "urls": [
      "https://www.instagram.com/*"
    ]
  },
  "local": false,
  "permissions": [
    "allow-download-media",
    "allow-save-media-bytes",
    "allow-open-external-url",
    "allow-prepare-download-folder",
    "allow-report-dm-unread",
    "allow-open-downloader-window",
    "allow-submit-downloader-probe"
  ]
}
