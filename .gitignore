# Rust build output
/src-tauri/target/
/src-tauri/permissions/autogenerated/
/src-tauri/gen/schemas/linux-schema.json

# JavaScript dependencies and local tooling
/node_modules/
/.npm/
/electron-linux/node_modules/
/electron-linux/dist/

# IDE and editor files
/.idea/
/.vscode/
*.code-workspace

# Local environment and machine-specific files
.env
.env.*
*.local
*.log
.freebuff
.freebuff/

# Private maintainer-only backup area (never commit or push this).
/backup/

# Local release staging, organized per version. Upload these files to GitHub
# Releases instead of committing binaries to the repository history.
/releases/versions/*/binaries/
!releases/**/README.md
!releases/versions.json

# Local release & audit reports (excluded from release trees)
/mds/
IG-Now_v*.md

# Local per-platform codebase snapshots & development truths (excluded from releases)
/codebases/

# Windows/macOS metadata
Thumbs.db
.DS_Store
